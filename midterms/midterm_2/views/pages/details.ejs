<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expense Details</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include("../partials/header") %>

    <main>
      <section class="page-heading">
        <div>
          <span class="eyebrow">Single expense</span>
          <h2>Expense Details</h2>
        </div>
        <a class="btn btn-secondary" href="/">Back</a>
      </section>

      <section class="detail-card">
        <div class="detail-top">
          <div>
            <span class="eyebrow">Category</span>
            <h3><%= expense.category %></h3>
          </div>
          <span class="detail-amount"><%= expense.amount %> GEL</span>
        </div>

        <div class="detail-grid">
          <div>
            <span>Description</span>
            <p><%= expense.description %></p>
          </div>

          <div>
            <span>Created At</span>
            <p><%= expense.createdAt %></p>
          </div>
        </div>

        <div class="actions">
          <a class="btn btn-warning" href="/expenses/<%= expense.id %>/edit">Edit</a>
          <form action="/expenses/<%= expense.id %>/delete" method="POST">
            <button class="btn-danger" type="submit">Delete</button>
          </form>
        </div>
      </section>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>
